let wrap, input, bodyEl, footEl, cur = -1, rows = [];

function injectCss() {
  if (document.getElementById('lsq-css')) return;
  const st = document.createElement('style');
  st.id = 'lsq-css';
  st.textContent = CSS;
  document.head.appendChild(st);
}

function build() {
  injectCss();
  wrap = document.createElement('div');
  wrap.className = 'lsq-wrap';
  wrap.setAttribute('role', 'dialog');
  wrap.setAttribute('aria-label', '강의 본문 검색');
  wrap.innerHTML = `
    <div class="lsq-dim" data-close></div>
    <div class="lsq-panel">
      <div class="lsq-head">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
        <input class="lsq-input" type="search" autocomplete="off" spellcheck="false" aria-label="검색어" placeholder="찾고 싶은 낱말을 넣어보세요.">
        <span class="lsq-esc">esc</span>
      </div>
      <div class="lsq-body" data-body></div>
      <div class="lsq-foot" data-foot><span>↑ ↓ 이동</span><span>Enter 그 자리로</span></div>
    </div>`;
  document.body.appendChild(wrap);
  input = wrap.querySelector('.lsq-input');
  bodyEl = wrap.querySelector('[data-body]');
  footEl = wrap.querySelector('[data-foot]');

  wrap.querySelector('[data-close]').addEventListener('click', close);
  input.addEventListener('input', onType);
  input.addEventListener('keydown', onKeyInPanel);
}

// 강의 화면 상단 바에 검색 칸을 노출한다(단축키를 모르는 사람도 보이게).
function mountBar() {
  const bar = document.querySelector('.read__bar');
  if (!bar || bar.querySelector('.lsq-bar')) return;
  const b = document.createElement('button');
  b.type = 'button';
  b.className = 'lsq-bar';
  b.setAttribute('aria-label', '강의 본문 검색');
  b.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg><span>검색</span><span class="lsq-k">( / )</span>`;
  b.addEventListener('click', () => open());
  // 강 이동 버튼 왼쪽에 둔다(맨 오른쪽 끝은 다음 강의 버튼 자리).
  const nav = bar.querySelector('.read__nav');
  if (nav) bar.insertBefore(b, nav); else bar.appendChild(b);
}

let timer = null;
function onType() {
  clearTimeout(timer);
  timer = setTimeout(render, 110);
}

function render() {
  const q = input.value;
  if (!q.trim()) {
    bodyEl.innerHTML = '<div class="lsq-empty">강 제목, 본문, 학습 목표, 실습 코드, 단어 사전을 함께 찾아요.</div>';
    rows = []; cur = -1; footEl.firstChild.textContent = '↑ ↓ 이동';
    return;
  }
  if (!INDEX) {
    bodyEl.innerHTML = '<div class="lsq-empty">본문을 불러오는 중이에요…</div>';
    ensureIndex().then(render);
    return;
  }
  const { groups, terms, total } = runSearch(q);
  if (!groups.length && !terms.length) {
    bodyEl.innerHTML = `<div class="lsq-empty"><b>${esc(q)}</b>는 강의 본문에 없어요.<br>낱말을 줄여서 다시 찾아보세요.</div>`;
    rows = []; cur = -1;
    footEl.firstChild.textContent = '0곳';
    return;
  }
  const needle = q.trim().toLowerCase();
  let html = '';
  groups.forEach((g) => {
    html += `<div class="lsq-lesson">${esc(g.no)}강 · ${esc(g.ltitle)}</div>`;
    g.hits.forEach((h) => {
      const where = [h.stage, h.blockTitle].filter(Boolean).map(esc).join(' · ');
      html += `<button type="button" class="lsq-row${h.kind === 'code' ? ' lsq-code' : ''}" data-lid="${esc(h.lid)}" data-book="${esc(h.book)}" data-text="${esc(h.text)}">`
        + `<div class="lsq-where">${where || '강 머리'} <b>${KIND_LABEL[h.kind] || ''}</b></div>`
        + `<div class="lsq-snip">${snippet(h.text, needle)}</div></button>`;
    });
    if (g.more) html += `<div class="lsq-more">이 강에 ${g.more}곳 더 있어요</div>`;
  });
  if (terms.length) {
    html += '<div class="lsq-termhead">단어 사전</div>';
    terms.forEach((t) => {
      const other = t.alias.length ? `<span class="lsq-term-a">${esc(t.alias.slice(0, 4).join(' · '))}</span>` : '';
      html += `<button type="button" class="lsq-row lsq-term" data-term="${esc(t.term)}">`
        + `<div class="lsq-term-t">${esc(t.term)}${other}</div>`
        + `<div class="lsq-term-d">${snippet(t.short, needle)}</div></button>`;
    });
  }
  bodyEl.innerHTML = html;
  bodyEl.scrollTop = 0;
  rows = [...bodyEl.querySelectorAll('.lsq-row')];
  rows.forEach((r) => r.addEventListener('click', () => (r.dataset.term
    ? jumpTerm(r.dataset.term)
    : jump({ book: r.dataset.book, lid: r.dataset.lid, text: r.dataset.text }))));
  cur = -1;
  footEl.firstChild.textContent = `${total}곳 · ${groups.length}개 강`;
}

function move(d) {
  if (!rows.length) return;
  if (cur >= 0) rows[cur].classList.remove('is-cur');
  cur = (cur + d + rows.length) % rows.length;
  rows[cur].classList.add('is-cur');
  rows[cur].scrollIntoView({ block: 'nearest' });
}

function onKeyInPanel(e) {
  if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
  else if (e.key === 'Enter') { e.preventDefault(); (cur >= 0 ? rows[cur] : rows[0]) && (cur >= 0 ? rows[cur] : rows[0]).click(); }
  else if (e.key === 'Escape') { e.preventDefault(); close(); }
}

function open(seed) {
  if (!wrap) build();
  wrap.classList.add('is-on');
  input.value = seed || '';
  render();
  ensureIndex();
  setTimeout(() => input.focus(), 0);
}

function close() {
  if (wrap) wrap.classList.remove('is-on');
}

// `/` 는 글자를 넣는 중이면 그대로 입력돼야 한다. 입력 칸 밖에서만 검색을 연다.
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && wrap && wrap.classList.contains('is-on')) { e.preventDefault(); e.stopPropagation(); close(); return; }
  const t = e.target;
  const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
  if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); open(); return; }
  if (e.key === '/' && !typing) { e.preventDefault(); open(); }
}, true);

function init() { injectCss(); mountBar(); }
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
// .read__bar 는 index.html 정적 마크업이라 한 번 꽂으면 된다. 해시 이동은 값싼 안전망으로만 둔다.
window.addEventListener('hashchange', () => setTimeout(mountBar, 60));
