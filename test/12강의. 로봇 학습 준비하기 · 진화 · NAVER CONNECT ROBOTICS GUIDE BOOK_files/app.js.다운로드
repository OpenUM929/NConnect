// ---------- 오버레이 (책-챕터 트리) ----------
function buildOverlayMenu() {
  const host = $('#overlayMenu');
  host.innerHTML = '';

  BOOKS.forEach((book) => {
    const li = el('li', 'overlay__book');
    li.dataset.bookId = book.id;

    const trigger = el('div', 'overlay__book-trigger');
    const prog = bookProgress(book);
    trigger.innerHTML = `
      <span class="overlay__book-no">${book.no}</span>
      <span class="overlay__book-name">${book.title}</span>
      <span class="overlay__book-count" data-book-count="${book.id}">${prog.done} / ${prog.total}강</span>
    `;
    li.appendChild(trigger);

    const ol = el('ol', 'overlay__chapters');
    book.chapters.forEach((ch) => {
      const cli = el('li');
      cli.dataset.chapterId = ch.id;
      if (isCompleted(ch.id)) cli.classList.add('is-done');
      const cbtn = el('button');
      cbtn.innerHTML = `
        <span class="ch-no">${ch.no}</span>
        <span class="ch-title">${ch.title}</span>
        <span class="ch-check" aria-hidden="true">${isCompleted(ch.id) ? '✓' : ''}</span>
      `;
      cbtn.addEventListener('click', () => {
        closeOverlay();
        go(`#read/${book.id}/${ch.id}`);
      });
      cli.appendChild(cbtn);
      ol.appendChild(cli);
    });
    li.appendChild(ol);

    host.appendChild(li);
  });

  $('#overlaySub').textContent = `${BOOKS.length}개 챕터 · ${totalChapters()}강`;
}

function toggleOverlayBook(bookId) {
  const all = $$('#overlayMenu .overlay__book');
  const target = all.find((el) => el.dataset.bookId === bookId);
  if (!target) return;
  const expanded = target.classList.contains('is-expanded');
  all.forEach((el) => el.classList.remove('is-expanded'));
  if (!expanded) {
    target.classList.add('is-expanded');
    state.expandedBookId = bookId;
  } else {
    state.expandedBookId = null;
  }
}

function openOverlay() {
  const ov = $('#overlay');
  ov.hidden = false;
  requestAnimationFrame(() => ov.classList.add('is-open'));
  document.body.classList.add('is-overlay-open');

  // (플랫 목록이라 챕터 펼침 불필요) — 현재 강 하이라이트는 아래 루프, 스크롤은 함수 끝에서

  // 모든 챕터 li에서 active 제거 후, 현재 보고 있는 강만 active + 완료 표시 갱신
  $$('#overlayMenu .overlay__chapters li').forEach((li) => {
    li.classList.toggle('is-active', li.dataset.chapterId === state.chapterId);
    const done = isCompleted(li.dataset.chapterId);
    li.classList.toggle('is-done', done);
    const noEl = li.querySelector('.ch-no');
    if (noEl) {
      const found = findChapter(li.dataset.chapterId);
      noEl.textContent = found ? found.chapter.no : '';
    }
    const checkEl = li.querySelector('.ch-check');
    if (checkEl) checkEl.textContent = done ? '✓' : '';
  });

  // 각 책의 진도 카운트 (n / m강) 갱신
  $$('#overlayMenu .overlay__book-count[data-book-count]').forEach((countEl) => {
    const bid = countEl.dataset.bookCount;
    const b = findBook(bid);
    if (b) {
      const p = bookProgress(b);
      countEl.textContent = `${p.done} / ${p.total}강`;
    }
  });

  // 열 때 현재 보고 있는 강이 화면에 오도록 목록을 스크롤 (맨 위가 아니라 내 위치)
  const activeLi = $('#overlayMenu .overlay__chapters li.is-active');
  const booksEl = $('#overlayMenu');
  if (booksEl) {
    requestAnimationFrame(() => {
      if (activeLi) {
        const delta = activeLi.getBoundingClientRect().top - booksEl.getBoundingClientRect().top;
        booksEl.scrollTop += delta - booksEl.clientHeight * 0.34;
      } else {
        booksEl.scrollTop = 0;
      }
    });
  }
}
function toggleOverlayBookOpen(bookId) {
  $$('#overlayMenu .overlay__book').forEach((el) => {
    el.classList.toggle('is-expanded', el.dataset.bookId === bookId);
  });
  state.expandedBookId = bookId;
}
function closeOverlay() {
  const ov = $('#overlay');
  ov.classList.remove('is-open');
  document.body.classList.remove('is-overlay-open');
  setTimeout(() => { ov.hidden = true; }, 380);
}

// ---------- 학습 진도 (localStorage) ----------
const PROGRESS_KEY = 'neotwin-edu:progress';
function loadProgress() {
  try {
    const raw = localStorage.getItem(PROGRESS_KEY);
    if (!raw) return { completed: [], last: null };
    const p = JSON.parse(raw);
    return { completed: Array.isArray(p.completed) ? p.completed : [], last: p.last || null };
  } catch { return { completed: [], last: null }; }
}
function saveProgress(p) {
  try { localStorage.setItem(PROGRESS_KEY, JSON.stringify(p)); } catch {}
}
function markCompleted(chapterId) {
  const p = loadProgress();
  if (!p.completed.includes(chapterId)) p.completed.push(chapterId);
  p.last = chapterId;
  saveProgress(p);
}
function saveLast(chapterId) {
  const p = loadProgress();
  p.last = chapterId;
  saveProgress(p);
}
function isCompleted(chapterId) {
  return loadProgress().completed.includes(chapterId);
}
function getLast() {
  return loadProgress().last;
}
function bookProgress(book) {
  const p = loadProgress();
  // 0강(프롤로그)은 강 수에 넣지 않는다. 분모에서 빼는 만큼 분자에서도 빼야 5/4 같은 값이 안 나온다
  const counted = book.chapters.filter((c) => +c.no > 0);
  const done = counted.filter((c) => p.completed.includes(c.id)).length;
  return { done, total: counted.length };
}

