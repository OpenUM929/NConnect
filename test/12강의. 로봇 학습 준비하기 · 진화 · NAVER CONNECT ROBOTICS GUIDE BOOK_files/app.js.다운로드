// ---------- 초기화 ----------
function init() {
  preloadBackgrounds();
  buildOverlayMenu();

  $('#menuBtn').addEventListener('click', openOverlay);
  $('#overlayClose').addEventListener('click', closeOverlay);
  $('.overlay__backdrop').addEventListener('click', closeOverlay);


  // 이용 안내 팝업 — 열기·닫기(배경 클릭·✕·ESC)
  const legal = $('#legalModal');
  if (legal) {
    const openLegal = () => {
      legal.hidden = false;
      // rAF는 탭이 뒤에 있으면 안 돌아 팝업이 투명한 채로 남는다. 타이머로 켠다
      setTimeout(() => legal.classList.add('is-open'), 10);
    };
    const closeLegal = () => {
      legal.classList.remove('is-open');
      // 사라지는 동안 클릭을 막고, 전환이 끝난 뒤에 감춘다
      setTimeout(() => { legal.hidden = true; }, 220);
    };
    $('#legalBtn').addEventListener('click', () => { closeOverlay(); openLegal(); });
    legal.querySelectorAll('[data-legal-close]').forEach((el) => el.addEventListener('click', closeLegal));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !legal.hidden) closeLegal();
    });
  }

  // 오버레이 빠른 이동
  $$('.overlay__quick').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = btn.dataset.quick;
      closeOverlay();
      if (q === 'books')    go('#books');
      if (q === 'glossary') go('#glossary');
    });
  });

  $$('.rail__item').forEach((b) => {
    b.addEventListener('click', () => {
      const v = b.dataset.view;
      if (v === 'books') go('#books');
      else if (v === 'glossary') go('#glossary');
    });
  });

  $$('[data-go]').forEach((el) => {
    el.addEventListener('click', () => {
      go(`#${el.dataset.go}`);
    });
  });

  // 키보드
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeOverlay();
    if (state.view === 'read' && !e.target.closest('input, textarea')) {
      if (e.key === 'ArrowLeft')  $('#readPrev')?.click();
      if (e.key === 'ArrowRight') $('#readNext')?.click();
    }
  });

  window.addEventListener('hashchange', handleRoute);
  handleRoute();
}

init();
